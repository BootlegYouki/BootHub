{
  "expo": {
    "name": "BootHub",
    "slug": "boot-hub",
    "version": "1.0.20",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": [
      "boothub",
      "com.googleusercontent.apps.384181018496-0iagia0c6tcmllboc6rhtijqsnnaj8se",
      "com.googleusercontent.apps.384181018496-16r5f89rhcl2i4ik1seigdfuao2io4bi"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bootlegyouki.boothub",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon.png",
        "tinted": "./assets/adaptive-icon-monochrome.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-monochrome.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#18181B"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow BootHub to access your photos to save and display dumped images.",
          "savePhotosPermission": "Allow BootHub to save images to your library."
        }
      ],
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "image",
              "max": 10
            },
            {
              "type": "file",
              "max": 10
            },
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "text"
            }
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "BootHubShareExtension",
                  "bundleIdentifier": "com.bootlegyouki.boothub.ShareExtension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.bootlegyouki.boothub"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "a05b49b3-4a8a-4030-b3d4-73f6a4e4ce0b"
      },
      "appleApplicationGroup": "group.com.bootlegyouki.boothub"
    }
  }
}
