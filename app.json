{
  "expo": {
    "name": "BootHub",
    "slug": "boot-hub",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#18181B"
    },
    "scheme": "boothub",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bootlegyouki.boothub",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon.png",
        "tinted": "./assets/adaptive-icon-monochrome.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18181B",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow BootHub to access your photos to save and display dumped images.",
          "savePhotosPermission": "Allow BootHub to save images to your library."
        }
      ],
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "image",
              "max": 10
            },
            {
              "type": "file",
              "max": 10
            },
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "text"
            }
          ]
        }
      ]
    ]
  }
}
